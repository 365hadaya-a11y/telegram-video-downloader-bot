# ─────────────────────────────────────────────────────────────
#  💎 PREMIUM VIDEO DOWNLOADER BOT — ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to `.env`
# 2. Fill in your Bot token from @BotFather
# 3. Start the bot with:  python -m bot   (or Docker)
# ─────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAYourBotTokenHere

# Admin Telegram user IDs (JSON array). Controls /panel, /broadcast, …
# Example: ADMIN_IDS=[111111111, 222222222]
ADMIN_IDS=[]

# Default bot language: "ar" (العربية) or "en" (English).
# Users can switch anytime with /language — the choice is stored per user.
DEFAULT_LANGUAGE=ar

# ─── Forced channel subscription (الاشتراك الإجباري) ─────────
# Users must join EVERY channel below before downloading (admins exempt).
# Multiple channels: comma-separated or JSON array.
#   FORCE_CHANNELS=@MyAnnouncements, @SecondChannel
#   FORCE_CHANNELS=["@A", "-1001234567890"]
# Legacy single-channel option (still supported):
#   FORCE_CHANNEL=@MyAnnouncements
# Runtime management: admins can add/remove channels live with
# /setchannel @Channel and /delchannel @Channel (or the admin panel) —
# those are stored in SQLite and do NOT require editing this file.
FORCE_CHANNELS=
FORCE_CHANNEL=

# ─── Webhook (production / Koyeb) ────────────────────────────
# Polling is the default (local dev). On a host like Koyeb set these:
# WEBHOOK_MODE=true
# WEBHOOK_URL=https://<app>-<org>.koyeb.app/webhook
# WEBHOOK_SECRET=<random string, optional — auto-generated if empty>
# WEBHOOK_PATH=/webhook
# WEBHOOK_PORT=8080
WEBHOOK_MODE=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8080

# ─── Web download site (موقع التحميل) ────────────────────────
# A premium download website is served from the SAME public URL as the
# webhook (port 8080). It reuses the bot's yt-dlp engine: paste a URL,
# pick a quality, watch a live progress bar, download straight to disk.
WEB_ENABLED=true

# Public base URL. If empty it is derived automatically from WEBHOOK_URL
# (the /webhook path is stripped). Only set it to override.
# WEB_BASE_URL=https://<app>-<org>.koyeb.app
WEB_BASE_URL=

# The site can serve files bigger than Telegram's 50 MB bot-API limit.
WEB_MAX_FILE_SIZE_MB=2000

# Finished/errored web downloads are deleted after this long (minutes).
WEB_JOB_TTL_MINUTES=120

# Max simultaneous downloads through the website (protects the instance).
WEB_MAX_CONCURRENT_JOBS=3

# Optional bot username (without @) — shows "open in Telegram" buttons on
# the website:  BOT_USERNAME=MyDownloaderBot
BOT_USERNAME=

# ─── Storage ─────────────────────────────────────────────────
DB_PATH=data/bot.db
TEMP_DIR=temp
LOG_DIR=logs
LOG_LEVEL=INFO

# ─── Downloads ───────────────────────────────────────────────
# Maximum file size allowed (MB). Telegram's standard Bot API caps
# uploads at 50 MB — set this to 50 unless you run a local Bot API
# server (which supports up to 2 GB).
MAX_FILE_SIZE_MB=2000

# How many heavy downloads can run at the same time (download queue).
DOWNLOAD_WORKERS=2

# How often the progress bar message is refreshed (seconds).
PROGRESS_UPDATE_SECONDS=2.5

# How long the fake "Uploading…" animation lasts (seconds).
# (The Bot API does not expose real upload progress.)
UPLOAD_PROGRESS_SECONDS=3.5

# Audio extraction bitrate.
AUDIO_BITRATE=192

# How many resolution options are shown in the "Choose Quality" menu.
MAX_QUALITY_CHOICES=8

# Max downloads per user per day.
DAILY_DOWNLOAD_LIMIT=20

# Auto-retry on network errors.
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2.0

# How long the user has to pick an option before the session expires.
CHOICE_TIMEOUT_SECONDS=150

# Path to FFmpeg binary (auto-detected if left empty).
FFMPEG_LOCATION=

# Optional HTTP(S) proxy for yt-dlp, e.g. socks5://127.0.0.1:1080
PROXY=

# Optional cookies file for private/age-restricted videos.
COOKIES_FILE=

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=4
RATE_LIMIT_WINDOW_SECONDS=3.0
RATE_LIMIT_WARN_COOLDOWN_SECONDS=20.0

# ─── Temp file cleanup ───────────────────────────────────────
CLEANUP_INTERVAL_MINUTES=30
CLEANUP_AGE_HOURS=6

# ─── Stickers (optional) ─────────────────────────────────────
# Option A: name of a public animated sticker set. The bot will try to
# map emojis (👋 ⏳ ⬇️ 📤 ✅ ❌ 🎉) to stickers in that set automatically.
# STICKER_SET_NAME=MyAnimatedStickerPack
STICKER_SET_NAME=

# Option B: hard-code individual sticker file_ids (takes priority).
# Get them via @BotFather or by replying /setsticker to a sticker.
STICKER_WELCOME_FILE_ID=
STICKER_LOADING_FILE_ID=
STICKER_DOWNLOADING_FILE_ID=
STICKER_UPLOADING_FILE_ID=
STICKER_SUCCESS_FILE_ID=
STICKER_ERROR_FILE_ID=
STICKER_CELEBRATION_FILE_ID=
